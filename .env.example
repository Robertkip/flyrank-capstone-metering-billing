# Copy to .env - never commit it. Stripe TEST MODE only (sk_test_...). Live keys are refused at startup.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me      # printed by: stripe listen --forward-to localhost:8000/webhooks/stripe
STRIPE_PRICE_PRO=price_replace_me           # a recurring test-mode Price for the Pro plan
PUBLIC_BASE_URL=http://localhost:8000
WEBHOOK_TOLERANCE_SECONDS=300
ALERT_LOG=./data/alerts.log
# Set automatically by docker-compose; without Docker the default is SQLite:
# DATABASE_URL=sqlite:///./data/billing.db
